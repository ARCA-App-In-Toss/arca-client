  "components": {
    "schemas": {
      "EntityId": {
        "type": "string",
        "minLength": 1
      },
      "Instant": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "KstDate": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "MemberProfile": {
        "type": "object",
        "properties": {
          "memberCode": {
            "type": "string",
            "minLength": 1
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "memberCode",
          "nickname"
        ]
      },
      "SessionContext": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "const": "GUEST"
              },
              "member": {
                "type": "null"
              }
            },
            "required": [
              "mode",
              "member"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "const": "ACTIVE"
              },
              "member": {
                "$ref": "#/components/schemas/MemberProfile"
              }
            },
            "required": [
              "mode",
              "member"
            ]
          }
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "context": {
            "$ref": "#/components/schemas/SessionContext"
          }
        },
        "required": [
          "accessToken",
          "expiresAt",
          "context"
        ]
      },
      "ActiveSessionResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "context": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "ACTIVE"
              },
              "member": {
                "$ref": "#/components/schemas/MemberProfile"
              }
            },
            "required": [
              "mode",
              "member"
            ]
          }
        },
        "required": [
          "accessToken",
          "expiresAt",
          "context"
        ]
      },
      "EstablishSessionInput": {
        "type": "object",
        "properties": {
          "anonymousKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "anonymousKey"
        ],
        "additionalProperties": false
      },
      "ConsentPolicy": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "policyId",
          "version",
          "title",
          "url",
          "required"
        ]
      },
      "ConsentPoliciesResponse": {
        "type": "object",
        "properties": {
          "consentPolicies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentPolicy"
            }
          }
        },
        "required": [
          "consentPolicies"
        ]
      },
      "ConsentReceiptInput": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "agreed": {
            "const": true
          }
        },
        "required": [
          "policyId",
          "version",
          "agreed"
        ],
        "additionalProperties": false
      },
      "CreateMemberInput": {
        "type": "object",
        "properties": {
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentReceiptInput"
            },
            "minItems": 1
          }
        },
        "required": [
          "consents"
        ],
        "additionalProperties": false
      },
      "UpdateNicknameInput": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "nickname"
        ],
        "additionalProperties": false
      },
      "Question": {
        "type": "object",
        "properties": {
          "questionId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "text"
        ]
      },
      "Sema": {
        "type": "object",
        "properties": {
          "dailySemaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "semaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "semaCode": {
            "type": "string",
            "minLength": 1
          },
          "dateKst": {
            "$ref": "#/components/schemas/KstDate"
          },
          "primaryQuestion": {
            "$ref": "#/components/schemas/Question"
          },
          "alternateQuestion": {
            "$ref": "#/components/schemas/Question"
          }
        },
        "required": [
          "dailySemaId",
          "semaId",
          "semaCode",
          "dateKst",
          "primaryQuestion",
          "alternateQuestion"
        ]
      },
      "AnswerCount": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "count"
        ]
      },
      "AnswerDetail": {
        "type": "object",
        "properties": {
          "answerId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "dailySemaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "semaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "semaCode": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "createdDateKst": {
            "$ref": "#/components/schemas/KstDate"
          },
          "isEdited": {
            "type": "boolean"
          },
          "question": {
            "$ref": "#/components/schemas/Question"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "dailySemaId",
          "semaId",
          "semaCode",
          "createdAt",
          "updatedAt",
          "createdDateKst",
          "isEdited",
          "question",
          "content"
        ]
      },
      "TodaySemaResponse": {
        "type": "object",
        "properties": {
          "dateKst": {
            "$ref": "#/components/schemas/KstDate"
          },
          "sema": {
            "$ref": "#/components/schemas/Sema"
          },
          "answer": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "UNANSWERED"
                  }
                },
                "required": [
                  "state"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "ANSWERED"
                  },
                  "value": {
                    "$ref": "#/components/schemas/AnswerDetail"
                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              }
            ]
          },
          "activeAnswerCount": {
            "$ref": "#/components/schemas/AnswerCount"
          }
        },
        "required": [
          "dateKst",
          "sema",
          "answer",
          "activeAnswerCount"
        ]
      },
      "CreateAnswerInput": {
        "type": "object",
        "properties": {
          "dailySemaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "semaId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "questionId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "dailySemaId",
          "semaId",
          "questionId",
          "content"
        ],
        "additionalProperties": false
      },
      "UpdateAnswerInput": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "SaveAnswerResult": {
        "type": "object",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/AnswerDetail"
          },
          "activeAnswerCount": {
            "$ref": "#/components/schemas/AnswerCount"
          }
        },
        "required": [
          "answer",
          "activeAnswerCount"
        ]
      },
      "DeleteAnswerResult": {
        "type": "object",
        "properties": {
          "activeAnswerCount": {
            "$ref": "#/components/schemas/AnswerCount"
          }
        },
        "required": [
          "activeAnswerCount"
        ]
      },
      "ApiError": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "INVALID_REQUEST"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "category",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "ENDPOINT_NOT_FOUND"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "category",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "METHOD_NOT_SUPPORTED"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "category",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "MEDIA_TYPE_NOT_ACCEPTABLE"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "category",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "MEDIA_TYPE_NOT_SUPPORTED"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "category",
              "requestId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "MEMBER_NOT_FOUND"
              },
              "category": {
                "const": "VALIDATION"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
